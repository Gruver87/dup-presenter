      "subtitle": "Rust-мост проверяет подтверждения и квитанции",
      "voice_ssml": "<speak><prosody rate=\"95%\">Rust-мост проверяет L1-транзакции: подтверждения, квитанции и привязку событий.<break time=\"250ms\"/> Функция verify_l1_tx возвращает число подтверждений и признак привязки события.</prosody></speak>",
      "bullets": [
        {
          "title": "Проверка квитанции",
          "desc": "Проверка семантического лога блокировки и статуса",
          "accent": "#00f5d4"
        },
        {
          "title": "Подтверждения",
          "desc": "Проверка минимального числа подтверждений и доказательства",
          "accent": "#38bdf8"
        },
        {
          "title": "RPC-вызовы",
          "desc": "Вызовы RPC и разрешение адреса RPC",
          "accent": "#c084fc"
        }
      ],
      "code": {
        "filename": "bridge/rust_bridge/src/main.rs · L242-255",
        "lines": [
          {
            "text": "fn verify_l1_tx(",
            "color": "#38bdf8"
          },
          {
            "text": "    rpc_url: &str,",
            "color": "#f8fafc"
          },
          {
            "text": "    tx_hash: &str,",
            "color": "#f8fafc"
          },
          {
            "text": "    args: &serde_json::Value,",
            "color": "#f8fafc"
          },
          {
            "text": ") -> Result<(u32, bool), String> {",
            "color": "#f8fafc"
          },
          {
            "text": "    let receipt = rpc_call(",
            "color": "#f8fafc"
          },
          {
            "text": "        rpc_url,",
            "color": "#f8fafc"
          },
          {
            "text": "        \"eth_getTransactionReceipt\",",
            "color": "#f8fafc"
          },
          {
            "text": "        serde_json::json!([tx_hash]),",
            "color": "#f8fafc"
          },
          {
            "text": "    )",
            "color": "#f8fafc"
          },
          {
            "text": "    .ok_or_else(|| \"L1 RPC check failed\".to_string())?;",
            "color": "#f8fafc"
          },
          {
            "text": "    if receipt.is_null() {",
            "color": "#f8fafc"
          },
          {
            "text": "        return Err(\"L1 receipt not found\".into());",
            "color": "#f472b6"
          },
          {
            "text": "    }",
            "color": "#f8fafc"
          }
        ]
      }
    },
