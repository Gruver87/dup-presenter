node_modules/
out/
models/
public/voice/*.wav
public/sfx/*.wav
public/sfx/library/
src/generated/deck_resolved.json
.env
secrets/
*.log
__pycache__/
*.pyc

# DUP Presenter 2.0 working files (facts, plan versions, raw LLM outputs)
work/
public/screens/*/
# Stock clips and music are downloaded/copied per build; music tracks may be copyrighted
public/stock/
public/music/
# Local UI recordings (record_ui.py output) are built per machine; not committed
public/ui_recordings/
assets/music/*
!assets/music/README-empty.txt

# AI-generated cinema clips (Grok Imagine) are large binaries; regenerate per machine, do not commit.
# decks/big-bang-cinema-real.json expects them; build_deck.py fails closed if they are missing.
public/cinema/
# Visual sourcing downloads (third-party archive media; per-machine, credited in out/*_visual_credits.txt)
public/visual/
# User drag-and-drop uploads via the local console (per-machine, metadata in work/<slug>/assets_meta.json)
public/uploads/
# 3D Studio generated/uploaded .glb models (large binaries, per-machine)
public/models3d/

# Hypothesis test cache
.hypothesis/
